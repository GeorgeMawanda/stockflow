{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "stockflow": {
      "root": ".",
      "framework": "fastify",
      "entrypoint": "api/index.js",
      "buildCommand": "npm ci"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "stockflow" }
    },
    {
      "source": "/auth/(.*)",
      "destination": { "service": "stockflow" }
    },
    {
      "source": "/webhooks/(.*)",
      "destination": { "service": "stockflow" }
    },
    {
      "source": "/health",
      "destination": { "service": "stockflow" }
    },
    {
      "source": "/internal/(.*)",
      "destination": { "service": "stockflow" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
